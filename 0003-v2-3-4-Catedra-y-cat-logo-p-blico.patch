+{ IdEventoAsis = "000999001", Nombre = nombreLargo, FkTipoEvento = "CAAB" });
+Afirmar("Crear() devuelve el id generado", idCat == 5505);
+Afirmar("Crear() devuelve nombre_asis = primeros 30 caracteres",
