+{% extends 'base.html' %}
+{% block titulo %}{{ catedra.nombre if catedra else 'Cátedra' }} · Cátedras USB{% endblock %}
+{% block contenido %}
+<nav aria-label="breadcrumb">
+    <ol class="breadcrumb small">
+        <li class="breadcrumb-item"><a href="{{ url_for('catedras.catalogo') }}">Catálogo</a></li>
+        <li class="breadcrumb-item active">{{ catedra.id_evento_asis if catedra else 'Error' }}</li>
+    </ol>
+</nav>
+
+{% if error %}
+<div class="alert alert-danger">
+    <strong><i class="fas fa-exclamation-triangle me-1"></i>{{ error.mensaje }}</strong>
+    {% if error.detalle %}<div class="small mt-1">{{ error.detalle }}</div>{% endif %}
+</div>
+{% endif %}
+
+{% if catedra %}
+<div class="card shadow-sm animate-fade-in">
+    <div class="card-body p-4">
+        <h1 class="h3 fw-bold mb-3"><i class="fas fa-book-open text-primary-custom me-2"></i>{{ catedra.nombre }}</h1>
+        <dl class="row mb-0">
+            <dt class="col-sm-4">Código ASIS</dt>
+            <dd class="col-sm-8">{{ catedra.id_evento_asis }}</dd>
+
+            <dt class="col-sm-4">Nombre en el ASIS <span class="text-muted small">(30 car., lo calcula la BD)</span></dt>
+            <dd class="col-sm-8"><code>{{ catedra.nombre_asis }}</code></dd>
+
+            <dt class="col-sm-4">Tipo de evento</dt>
+            <dd class="col-sm-8">
+                {{ tipo_evento.nombre if tipo_evento else '' }}
+                <span class="badge badge-secondary">{{ catedra.fk_tipo_evento }}</span>
+            </dd>
+
+            <dt class="col-sm-4">Dependencia</dt>
+            <dd class="col-sm-8">
+                {% if dependencia %}{{ dependencia.nombre }} <span class="badge badge-secondary">{{ dependencia.id_dependencia }}</span>
+                {% elif catedra.fk_dependencia %}{{ catedra.fk_dependencia }}
+                {% else %}<span class="text-muted">Sin dependencia asignada</span>{% endif %}
+            </dd>
+
+            <dt class="col-sm-4">Estado</dt>
+            <dd class="col-sm-8"><span class="badge {{ 'badge-success' if catedra.activo else 'badge-danger' }}">{{ 'Activa' if catedra.activo else 'Inactiva' }}</span></dd>
+
+            <dt class="col-sm-4">Registrada</dt>
+            <dd class="col-sm-8">{{ catedra.creado_en[:10] }}</dd>
+        </dl>
+    </div>
+</div>
+{% endif %}
+
+<a class="btn btn-outline-primary mt-3" href="{{ url_for('catedras.catalogo') }}">
+    <i class="fas fa-arrow-left me-1"></i>Volver al catálogo
+</a>
+{% endblock %}
