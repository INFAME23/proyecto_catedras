+// ==========================================================================
+class RepositorioAliasProgramaFalso : IRepositorioAliasPrograma
+{
+    private readonly Dictionary<long, AliasPrograma> _tabla = new();
+    private long _siguienteId = 5; // en el script real los ids semilla son 1, 3 y 4
