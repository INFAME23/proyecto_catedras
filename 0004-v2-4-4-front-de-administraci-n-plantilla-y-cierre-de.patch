+# ==========================================================================
+
+CATEDRAS_POR_PAGINA = 50
+
+
+def _leer_form_catedra():
+    return {
+        'id_evento_asis': request.form.get('id_evento_asis', '').strip(),
+        'nombre': request.form.get('nombre', '').strip(),
