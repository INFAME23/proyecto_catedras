+        <li class="breadcrumb-item"><a href="{{ url_for('admin.panel') }}">Administración</a></li>
+        <li class="breadcrumb-item"><a href="{{ url_for('admin.alias_listar') }}">Alias de programa</a></li>
+        <li class="breadcrumb-item active">Nuevo</li>
+    </ol>
+</nav>
+<h1 class="h3 fw-bold mb-3"><i class="fas fa-tags text-primary-custom me-2"></i>Nuevo alias</h1>
+
+<div class="card shadow-sm">
+    <div class="card-body">
+        {# Solo existe el formulario de CREAR: la API no tiene PUT/PATCH para alias. #}
+        <form method="post" action="{{ url_for('admin.alias_nuevo') }}">
+            <div class="mb-3">
+                <label class="form-label" for="texto_normalizado">Texto normalizado</label>
+                <input type="text" class="form-control" id="texto_normalizado" name="texto_normalizado" maxlength="200" required
+                       value="{{ alias.texto_normalizado if alias else '' }}">
+                <div class="form-text">Debe ser único (p. ej. "ing. de datos").</div>
+            </div>
+
+            <div class="mb-3">
+                <label class="form-label" for="fk_programa">Programa</label>
+                <select class="form-select" id="fk_programa" name="fk_programa" required>
+                    <option value="">-- Selecciona --</option>
+                    {% for p in programas %}
+                    <option value="{{ p.codigo }}" {% if alias and alias.fk_programa == p.codigo %}selected{% endif %}>{{ p.codigo }} · {{ p.nombre }}</option>
+                    {% endfor %}
+                </select>
+            </div>
+
+            <div class="mb-3">
+                <label class="form-label" for="origen">Origen (opcional)</label>
