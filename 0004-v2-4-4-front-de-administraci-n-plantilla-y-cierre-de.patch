+{% extends 'base.html' %}
+{% block titulo %}Programas académicos · Administración{% endblock %}
+{% block contenido %}
+<nav aria-label="breadcrumb">
+    <ol class="breadcrumb small">
+        <li class="breadcrumb-item"><a href="{{ url_for('admin.panel') }}">Administración</a></li>
+        <li class="breadcrumb-item active">Programa académico</li>
+    </ol>
+</nav>
+
+<div class="d-flex justify-content-between align-items-center mb-3">
+    <h1 class="h3 fw-bold mb-0"><i class="fas fa-graduation-cap text-primary-custom me-2"></i>Programas académicos</h1>
+    <a class="btn btn-primary" href="{{ url_for('admin.programas_nuevo') }}">
+        <i class="fas fa-plus me-1"></i>Nuevo programa
+    </a>
+</div>
+
+<div class="card shadow-sm">
+    <div class="card-body p-0">
+        {% if programas %}
+        <div class="table-responsive">
+            <table class="table table-hover align-middle mb-0">
+                <thead class="table-light">
+                    <tr><th>Código</th><th>Nombre</th><th>Facultad</th><th>Nivel</th><th>Activo</th><th class="text-end">Acciones</th></tr>
+                </thead>
+                <tbody>
+                    {% for p in programas %}
+                    <tr>
+                        <td class="fw-semibold">{{ p.codigo }}</td>
+                        <td>{{ p.nombre }}</td>
+                        <td>{{ p.fk_facultad or '—' }}</td>
+                        <td><span class="badge badge-secondary">{{ p.nivel }}</span></td>
+                        <td><span class="badge {{ 'badge-success' if p.activo else 'badge-danger' }}">{{ 'Sí' if p.activo else 'No' }}</span></td>
+                        <td class="text-end">
+                            <a class="btn btn-sm btn-outline-primary" href="{{ url_for('admin.programas_editar', codigo=p.codigo) }}"><i class="fas fa-edit"></i></a>
+                            <form class="d-inline" method="post" action="{{ url_for('admin.programas_eliminar', codigo=p.codigo) }}"
+                                  onsubmit="return confirm('¿Eliminar el programa {{ p.codigo }}? Si tiene asistentes, la base de datos lo impedirá.');">
+                                <button class="btn btn-sm btn-outline-danger" type="submit"><i class="fas fa-trash"></i></button>
+                            </form>
+                        </td>
+                    </tr>
+                    {% endfor %}
+                </tbody>
+            </table>
+        </div>
+        {% else %}
+        <p class="text-muted text-center py-4 mb-0">No hay programas registrados.</p>
+        {% endif %}
+    </div>
+</div>
+{% endblock %}
