# ==========================================================================
#  env.ejemplo  ·  Subversión v7.1 · RF-S6 (correo del código de recuperación)
# --------------------------------------------------------------------------
#  Copia este archivo como  front_catedras/.env  (o ponlo como '.env' junto al
#  docker-compose.yml) y llena SOLO lo de tu proveedor. '.env' está en
#  .gitignore: no subas credenciales. Sin SMTP_HOST el correo queda apagado.
# ==========================================================================

SECRET_KEY=cambia-esto-por-un-texto-largo-y-aleatorio

# --- Opción A · Gmail con contraseña de aplicación (cuenta dedicada al proyecto: catedracambioc@gmail.com)
#     Requiere verificación en 2 pasos y crear una "contraseña de aplicación".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=catedracambioc@gmail.com
SMTP_CLAVE=contraseña-de-aplicación-de-16-letras
SMTP_REMITENTE=catedracambioc@gmail.com
SMTP_NOMBRE_REMITENTE=Cátedras USB

# --- Opción B · Brevo (gratis, 300 correos/día): smtp-relay.brevo.com, 587, starttls
# --- Opción C · Mailtrap / Mailpit para PRUEBAS (el correo no sale a nadie):
#     Mailpit local:  docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
#       SMTP_HOST=host.docker.internal  SMTP_PORT=1025  SMTP_SEGURIDAD=ninguna
#       SMTP_REMITENTE=catedras@localhost    (bandeja en http://localhost:8025)

# --- Solo desarrollo sin SMTP: escribe el correo en el log del front en vez de enviarlo
# CORREO_MODO_CONSOLA=1

# --- D53 · QR de asistencia: la dirección PÚBLICA del front que va dentro del QR.
#     El celular del estudiante debe poder abrirla y la ubicación del navegador solo
#     funciona en https (o localhost). Vacía = la dirección con la que se abre la pantalla.
# URL_PUBLICA=https://catedras.usbmed.edu.co

# --- v7.2 · IP real de quien registra la asistencia. Detrás de un proxy (Render) la IP que ve el front es la del
#     proxy. Pon aquí cuántos proxies de confianza hay delante (en Render, 1). Con 0 (por defecto) no se confía en
#     X-Forwarded-For. Sin esto la IP guardada en cada asistencia no sirve para detectar muchas firmas desde un mismo lugar.
# PROXY_CONFIABLES=1
